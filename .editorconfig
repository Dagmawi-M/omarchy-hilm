root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{sh,bash}]
indent_size = 2

[bin/omarchy-hilm-rotate]
indent_size = 2

[{bin/omarchy-hilm,bin/omarchy-hilm-theme,*.py}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false
